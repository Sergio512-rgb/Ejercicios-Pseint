Proceso areaperimetrorectangulo2
	Definir  base,altura,area,perimetro Como Entero;
	Definir lado1,lado2,lado3 Como Entero;
	
	Escribir "ingrese el valor de la base";
	Leer base;
	
	Escribir "ingrese el valor de la altura";
	Leer altura;
	
	area<-base*altura/2;
	Escribir "el area del rectangulo es:", area;
	
	Escribir "----------------------------------";
	Escribir "ingrese el valor del lado 1";
	Leer lado1;
	
	Escribir "ingrese el valor del lado 2";
	Leer lado2;
	
	Escribir "ingrese el valor del lado 3";
	Leer lado3;
	
	perimetro<-lado1+lado2+lado3;
	Escribir "el perimetro del rectangulo es:", perimetro;
	
FinProceso
